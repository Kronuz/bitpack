# bitpack: 128 integers in four lanes; one SIMD register decodes four in order.
# Render: d2 docs/bitpack.d2 docs/bitpack.svg
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent

direction: right
block: "128 × uint32\nat b bits each"
lanes: four lanes {
  grid-columns: 1
  l0: "lane 0: 0, 4, 8, …"
  l1: "lane 1: 1, 5, 9, …"
  l2: "lane 2: 2, 6, 10, …"
  l3: "lane 3: 3, 7, 11, …"
}
bytes: "16 × b bytes\nSIMD-BP128 layout"
block -> lanes
lanes -> bytes: "pack"
